---
import { listPosts, blogPath } from '../lib/blog';
import type { Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const posts = await listPosts(lang);
---

<section class="section blog-lb">
  <div class="container">
    {
      posts.length > 0 ? (
        <div class="blog-grid-lb">
          {posts.map((post) => (
            <article class="post-card-lb">
              {post.heroImage && (
                <a href={blogPath(lang, post.slug)} aria-label={post.title}>
                  <img
                    class="post-image"
                    src={post.heroImage}
                    alt={post.heroAlt || post.title}
                    loading="lazy"
                  />
                </a>
              )}

              <div>
                <p class="post-date">
                  {new Date(post.pubDate).toLocaleDateString(
                    lang === 'es' ? 'es-ES' : 'en-US',
                    { day: '2-digit', month: 'long', year: 'numeric' },
                  )}
                </p>

                <h2 class="post-title">
                  <a href={blogPath(lang, post.slug)}>{post.title}</a>
                </h2>

                <p class="post-excerpt">{post.description}</p>

                <a class="link-arrow" href={blogPath(lang, post.slug)}>
                  {lang === 'es' ? 'Leer artículo' : 'Read article'}
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="section-lead">
          {lang === 'es'
            ? 'Todavía no hay artículos publicados.'
            : 'No articles have been published yet.'}
        </p>
      )
    }
  </div>
</section>
