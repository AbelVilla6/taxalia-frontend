---
import { localizePath, ui, type Lang } from '../i18n';

export interface Props {
  lang?: Lang;
  variant?: 'default' | 'wide';
}

const { lang = 'en', variant = 'default' } = Astro.props;
const copy = ui[lang].cta;
---

<section class={`section-sm cta-section ${variant === 'wide' ? 'cta-section-wide' : ''}`} aria-labelledby="cta-heading">
  <div class="container">
    <div class={`cta-grid ${variant === 'wide' ? 'cta-grid-wide' : ''}`}>
      <!-- Left: heading -->
      <div>
        <h2 id="cta-heading" class="section-title" style="text-transform:none;font-weight:500;font-size:clamp(1.8rem,3vw,3rem);">
          {copy.title}
        </h2>
        <p class="section-lead" style="margin-top:0.5rem;font-size:var(--text-sm);">
          {copy.lead}
        </p>
      </div>

      <!-- Center: contact details -->
      <address class="cta-contact-list" style="font-style:normal;">
        <div class="cta-contact-item">
          <svg class="cta-contact-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.78a16 16 0 0 0 6.29 6.29l1.64-1.64a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span class="flag-icon flag-icon-us" aria-hidden="true"><span></span></span>
          <span><span aria-label="United States phone number to be defined">{lang === 'es' ? 'POR DEFINIR' : 'to be defined'}</span></span>
        </div>

        <div class="cta-contact-item">
          <svg class="cta-contact-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.78a16 16 0 0 0 6.29 6.29l1.64-1.64a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span class="flag-icon flag-icon-es" aria-hidden="true"><span></span></span>
          <a href="tel:+34681871771">+34 681 871 771</a>
        </div>

        <div class="cta-contact-item">
          <svg class="cta-contact-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
           <a href="mailto:info@hitaxalia.com">info@hitaxalia.com</a>
        </div>

        <div class="cta-contact-item">
          <svg class="cta-contact-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span>Miami, Florida 33135</span>
        </div>
      </address>

    </div>

    <div style="margin-top:1.5rem;text-align:center;">
      <a
        href="https://instagram.com/lbcotax"
        class="cta-contact-item"
        style="justify-content:center;gap:0.65rem;font-size:var(--text-xs);font-weight:700;letter-spacing:0.1em;text-transform:uppercase;display:inline-flex;"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="var(--color-primary)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
        </svg>
        {copy.followUs}&nbsp;
        <strong>@lbcotax</strong>
      </a>
    </div>
  </div>
</section>
