---
import '../assets/css/lb-co.css';
import { basePathFromPathname, languages, localizePath, type Lang } from '../i18n';
import ChatWidget from '../components/ChatWidget.astro';

export interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** Overrides the path-derived canonical URL (e.g. blog posts). */
  canonicalUrl?: string;
  /**
   * Overrides the path-derived hreflang alternates. Langs absent from the
   * map render no alternate link (e.g. an article without translation).
   */
  alternateUrls?: Partial<Record<Lang, string>>;
  ogTitle?: string;
  ogDescription?: string;
  /** Absolute URL of the Open Graph image. */
  ogImage?: string;
  ogType?: string;
}

const {
  title = 'LB & CO Global Advisors',
  description = 'Independent, data-driven advisory and valuation services to help businesses, investors, and professionals make informed decisions across the United States.',
  lang = 'en',
  canonicalUrl,
  alternateUrls,
  ogTitle,
  ogDescription,
  ogImage,
  ogType = 'website',
} = Astro.props;

const htmlLang = languages[lang].htmlLang;
const site = Astro.site ?? new URL('https://lbcoglobaladvisors.com');
const basePath = basePathFromPathname(Astro.url.pathname);
const showChat = basePath !== '/contact';
const canonical = canonicalUrl ?? new URL(localizePath(lang, basePath), site).toString();
const alternateEn = alternateUrls
  ? alternateUrls.en ?? null
  : new URL(localizePath('en', basePath), site).toString();
const alternateEs = alternateUrls
  ? alternateUrls.es ?? null
  : new URL(localizePath('es', basePath), site).toString();
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {alternateEn && <link rel="alternate" hreflang={languages.en.htmlLang} href={alternateEn} />}
    {alternateEs && <link rel="alternate" hreflang={languages.es.htmlLang} href={alternateEs} />}
    {alternateEn && <link rel="alternate" hreflang="x-default" href={alternateEn} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <slot name="head" />

    <!-- Base stylesheet (clinica-premium) -->
    <link rel="stylesheet" href="/assets/css/clinica-premium.css" />
    <!-- LB & CO overrides -->
    <link rel="stylesheet" href="/assets/css/lb-co.css" />

    <script is:inline>
      (() => {
        try {
          const pathname = window.location.pathname.replace(/\/+$/, '') || '/';
          const isHome = pathname === '/' || pathname === '/es';
          const stored = window.localStorage.getItem('taxalia:chat-state');
          const state = stored === 'open' || stored === 'closed' ? stored : (isHome ? 'open' : 'closed');
          document.documentElement.dataset.chatState = state;
        } catch {
          document.documentElement.dataset.chatState = 'open';
        }
      })();
    </script>

    <!-- Preconnect fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon placeholder -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
    {showChat && <ChatWidget lang={lang} />}

    <script>
      // Sticky header scroll class
      const header = document.querySelector('.site-header') as HTMLElement | null;
      if (header) {
        const onScroll = () => {
          header.classList.toggle('is-scrolled', window.scrollY > 20);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      const promoBanner = document.querySelector('.free-consultation-banner') as HTMLElement | null;
      if (promoBanner) {
        const promoClose = promoBanner.querySelector<HTMLButtonElement>('.free-consultation-close');
        const onPromoScroll = () => {
          promoBanner.classList.toggle('is-hidden', window.scrollY > 24);
        };
        promoClose?.addEventListener('click', () => {
          promoBanner.hidden = true;
        });
        onPromoScroll();
        window.addEventListener('scroll', onPromoScroll, { passive: true });
      }

      // Mobile menu toggle
      const toggle = document.getElementById('menu-toggle');
      const drawer = document.getElementById('mobile-drawer');
      const drawerClose = document.getElementById('drawer-close');

      toggle?.addEventListener('click', () => {
        drawer?.classList.add('is-open');
      });
      drawerClose?.addEventListener('click', () => {
        drawer?.classList.remove('is-open');
      });

      // Chat widget bootstrap
      const chatWidget = document.getElementById('chat-widget');
      if (chatWidget) {
        import('../scripts/chat-client.ts').then(({ init }) => {
          init({ mount: '#chat-widget', config: '#chat-config' });
        }).catch((err) => {
          console.error('[chat] failed to load chat-client.ts', err);
        });
      }
    </script>
  </body>
</html>
