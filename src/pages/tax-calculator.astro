---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TaxCalculatorPage from '../components/TaxCalculatorPage.astro';
import { ui } from '../i18n';

const lang = 'en';
const copy = ui[lang];
---

<Base
  title={copy.meta.taxCalculator.title}
  description={copy.meta.taxCalculator.description}
  lang={lang}
>
  <Header activePage="taxCalculator" lang={lang} />
  <main id="main-content">
    <TaxCalculatorPage lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
