---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import CTA from '../../components/CTA.astro';
import Footer from '../../components/Footer.astro';
import { contactEmail, contactMailto, ui } from '../../i18n';

const lang = 'es';
const copy = ui[lang];
const backendBase = (import.meta.env.PUBLIC_CHAT_API_BASE ?? 'http://localhost:4324').replace(/\/+$/, '');
const mailtoHref = contactMailto(lang);
const calcomUrl = (import.meta.env.PUBLIC_CALCOM_URL ?? 'https://cal.com/felipe-costa').replace(/\/+$/, '');
const calcomLink = calcomUrl.replace('https://cal.com/', '');
---

<Base
  title={copy.meta.contact.title}
  description={copy.meta.contact.description}
  lang={lang}
>
  <Header activePage="contact" lang={lang} />
  <main id="main-content">
    <section class="section-sm contact-hero-section" style="background:var(--color-bg-soft);">
      <div class="container">
        <h1 class="section-title" style="text-transform:none;font-weight:500;">{copy.pages.contact.title}</h1>
      </div>
    </section>

    <section class="section contact-content-section">
      <div class="container">
        <div class="grid grid-2" style="--grid-gap:4rem;align-items:start;">
          <div>
            <h2 class="section-title" style="font-size:1.8rem;text-transform:none;font-weight:500;margin-bottom:1.5rem;">
              {copy.pages.contact.consultation}
            </h2>
            <form id="contact-form" class="form-group" style="display:grid;gap:1rem;">
              <div class="form-field">
                <label for="name" style="font-size:var(--text-xs);font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-primary-dark);display:block;margin-bottom:0.4rem;">
                  {copy.pages.contact.name}
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  placeholder={copy.pages.contact.namePlaceholder}
                  required
                  minlength="2"
                  maxlength="120"
                  style="width:100%;padding:0.75rem 1rem;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:var(--color-surface);font-family:var(--font-body);font-size:var(--text-sm);color:var(--color-text);"
                />
              </div>
              <div class="form-field">
                <label for="email" style="font-size:var(--text-xs);font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-primary-dark);display:block;margin-bottom:0.4rem;">
                  {copy.pages.contact.email}
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder={copy.pages.contact.emailPlaceholder}
                  required
                  maxlength="254"
                  style="width:100%;padding:0.75rem 1rem;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:var(--color-surface);font-family:var(--font-body);font-size:var(--text-sm);color:var(--color-text);"
                />
              </div>
              <div class="form-field">
                <label for="message" style="font-size:var(--text-xs);font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-primary-dark);display:block;margin-bottom:0.4rem;">
                  {copy.pages.contact.message}
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  placeholder={copy.pages.contact.messagePlaceholder}
                  required
                  minlength="10"
                  maxlength="4000"
                  style="width:100%;padding:0.75rem 1rem;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:var(--color-surface);font-family:var(--font-body);font-size:var(--text-sm);color:var(--color-text);resize:vertical;"
                ></textarea>
              </div>
              <input type="hidden" name="lang" value={lang} />
              <button id="contact-submit" type="submit" class="btn" style="align-self:flex-start;">
                {copy.pages.contact.send}
              </button>
              <p id="contact-status" class="editorial-text" role="status" aria-live="polite" style="min-height:1.5rem;margin:0;"></p>
              <p class="editorial-text" style="margin:0;">{copy.pages.contact.note}</p>
            </form>
          </div>

          <div style="padding-top:3.5rem;">
            <CTA lang={lang} variant="centered-roomy" />
          </div>
        </div>
      </div>
    </section>
    <section id="booking" class="section" style="background:var(--color-bg-soft);">
      <div class="container">
        <p class="eyebrow">Consulta gratuita</p>
        <h2 class="section-title" style="font-size:1.8rem;text-transform:none;font-weight:500;margin-bottom:2rem;">
          Agenda tu cita
        </h2>
        <div
          id="cal-booking-inline"
          style="width:100%;min-height:600px;border-radius:var(--radius-md);overflow:hidden;"
        ></div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />

  <script is:inline define:vars={{ calcomLink }}>
    (function (C, A, L) {
      let p = function (a, ar) { a.q.push(ar); };
      let d = C.document;
      C.Cal = C.Cal || function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () { p(api, arguments); };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === 'string') {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ['-init-wasm', ar[1], ar[2]]);
          } else {
            p(cal, ar);
          }
          return;
        }
        p(cal, ar);
      };
    })(window, 'https://app.cal.com/embed/embed.js', 'init');

    Cal('init', 'taxalia-booking', { origin: 'https://cal.com' });
    Cal.ns['taxalia-booking']('inline', {
      elementOrSelector: '#cal-booking-inline',
      config: { layout: 'month_view' },
      calLink: calcomLink,
    });
    Cal.ns['taxalia-booking']('ui', {
      hideEventTypeDetails: false,
      layout: 'month_view',
    });
  </script>

  <script define:vars={{ backendBase, contactEmail, mailtoHref, messages: {
    sending: copy.pages.contact.sending,
    success: copy.pages.contact.success,
    error: copy.pages.contact.error,
    send: copy.pages.contact.send,
  } }}>
    const form = document.getElementById('contact-form');
    const submitButton = document.getElementById('contact-submit');
    const status = document.getElementById('contact-status');

    if (form && submitButton && status) {
      const submitLabel = submitButton.textContent ?? messages.send;

      const showStatus = (message) => {
        status.textContent = '';
        const [before, after] = message.split('{email}');
        if (after === undefined) {
          status.textContent = message;
          return;
        }
        const link = document.createElement('a');
        link.href = mailtoHref;
        link.textContent = contactEmail;
        status.append(before, link, after);
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.textContent = '';
        submitButton.disabled = true;
        submitButton.textContent = messages.sending;

        const formData = new FormData(form);
        const payload = {
          name: String(formData.get('name') ?? '').trim(),
          email: String(formData.get('email') ?? '').trim(),
          message: String(formData.get('message') ?? '').trim(),
          lang: String(formData.get('lang') ?? 'es'),
        };

        try {
          const response = await fetch(`${backendBase}/contact`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json',
            },
            body: JSON.stringify(payload),
          });

          const body = await response.json().catch(() => null);
          if (!response.ok) {
            throw new Error(body?.error?.message ?? messages.error);
          }

          form.reset();
          status.textContent = messages.success;
        } catch (error) {
          showStatus(error instanceof Error && error.message ? error.message : messages.error);
        } finally {
          submitButton.disabled = false;
          submitButton.textContent = submitLabel;
        }
      });
    }
  </script>
</Base>
