---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FreeConsultationBanner from '../components/FreeConsultationBanner.astro';
import Services from '../components/Services.astro';
import Blog from '../components/Blog.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import { ui } from '../i18n';

const lang = 'en';
const copy = ui[lang];
---

<Base
  title={copy.meta.home.title}
  description={copy.meta.home.description}
  lang={lang}
>
  <Header lang={lang} />
  <FreeConsultationBanner lang={lang} />
  <main id="main-content">
    <Hero lang={lang} />
    <Services lang={lang} />
    <Blog lang={lang} />
    <CTA lang={lang} variant="centered" />
  </main>
  <Footer lang={lang} />
</Base>
